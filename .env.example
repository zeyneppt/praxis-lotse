# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env wird nie committet.

# LLM-Anbieter:
#   fake      -> Tests und CI, ohne Modell, deterministisch
#   ollama    -> lokales Modell (kostenlos, keine Daten verlassen den Rechner)
#   anthropic -> Claude über die API (kostenpflichtig, optional)
LLM_PROVIDER=fake
LLM_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=800

# Ollama (läuft auf dem Host: `ollama serve`, Modell: `ollama pull qwen2.5:7b`)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Nur für LLM_PROVIDER=anthropic (dann z. B. LLM_MODEL=claude-haiku-5-5)
ANTHROPIC_API_KEY=

# Datenbank (Docker Compose)
DATABASE_URL=postgresql+psycopg://lotse:lotse@db:5432/lotse

# Verzeichnis mit standorte.json und wissen/ (im Container schreibgeschützt gemountet)
DATA_DIR=/data

# Embeddings (lokal, Spec 003)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Frontend
VITE_API_URL=http://localhost:8000
